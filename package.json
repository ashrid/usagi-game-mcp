{
  "name": "usagi-game-mcp",
  "version": "0.1.0",
  "description": "MCP server for Usagi game engine",
  "type": "module",
  "main": "dist/index.js",
  "bin": { "usagi-game-mcp": "dist/index.js" },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "USAGI_INTEGRATION=1 vitest run",
    "test:fuzz": "USAGI_FUZZ=1 vitest run"
  },
  "dependencies": {
    "@inquirer/checkbox": "^4.0.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@jimp/core": "^1.6.0",
    "jimp": "^1.6.0",
    "chokidar": "^4.0.3",
    "node-pty": "^1.0.0",
    "proper-lockfile": "^4.1.2",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  },
  "engines": { "node": ">=20.0.0" }
}
